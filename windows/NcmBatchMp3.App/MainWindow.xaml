<Window x:Class="NcmBatchMp3.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NCM 批量转 MP3"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="630"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F3"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <Grid x:Name="AppRoot" Background="{DynamicResource CanvasBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/assets/icon.png" Width="42" Height="42" Stretch="Uniform" />
                    <TextBlock Text="NCM 批量转 MP3"
                               FontSize="21"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="11,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="队列" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueuedCountText" Text="0" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="完成" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="FinishedCountText" Text="0" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="引擎" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="FfmpegStatusText" Text="可用" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FailedCountText" Text="0" Visibility="Collapsed" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE895;"
                            ToolTip="检查更新"
                            Click="CheckUpdate_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource IconButton}"
                            Content="&#xE706;"
                            ToolTip="切换深浅色"
                            Click="Theme_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="AddFilesButton" Click="AddFiles_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="16" Margin="0,-1,6,0" />
                                <TextBlock Text="添加文件" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFolderButton" Click="AddFolder_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▢" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="添加文件夹" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveButton" Content="移除" Click="Remove_Click" IsEnabled="False" Margin="0,0,8,0" />
                        <Button x:Name="ClearButton" Content="清空" Click="Clear_Click" IsEnabled="False" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="打开结果文件" Click="OpenOutput_Click" Margin="0,0,8,0" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Margin="0,0,8,0" />
                        <Button x:Name="StartButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="开始转换"
                                Click="Start_Click"
                                IsEnabled="False"
                                MinWidth="92" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Content="开始使用教程" HorizontalAlignment="Left" Click="Tutorial_Click" />

                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="转换队列" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="QueueSummaryText"
                                           Text="0 个文件"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="QueueList"
                                         ItemsSource="{Binding QueueItems}"
                                         SelectionChanged="QueueList_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" MaxWidth="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource EmphasisSurfaceBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Detail}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border x:Name="EmptyState"
                                        Background="{DynamicResource RaisedSurfaceBrush}"
                                        BorderBrush="{DynamicResource StrongLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="↓" FontSize="34" HorizontalAlignment="Center" />
                                        <TextBlock Text="拖入 NCM 文件或文件夹" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="输出" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        Content="&#xE8B7;"
                                        ToolTip="选择输出目录"
                                        Click="ChooseOutput_Click" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,13">
                                <RadioButton x:Name="PreferMp3Radio" Content="优先 MP3" IsChecked="True" />
                                <RadioButton x:Name="OriginalRadio" Content="原格式" />
                            </StackPanel>
                            <CheckBox x:Name="RenameCheckBox" Content="按歌曲信息命名" IsChecked="True" />
                            <CheckBox x:Name="OverwriteCheckBox" Content="覆盖同名文件" />
                            <CheckBox x:Name="RecursiveCheckBox" Content="搜索子文件夹" IsChecked="True" />
                        </StackPanel>

                        <Grid Grid.Row="1" Background="{DynamicResource LineBrush}" Margin="0,14,0,0" />

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="日志" FontSize="15" FontWeight="SemiBold" />
                            <ListBox x:Name="LogList"
                                     Grid.Row="2"
                                     ItemsSource="{Binding Logs}"
                                     BorderThickness="0"
                                     Background="{DynamicResource RaisedSurfaceBrush}"
                                     Foreground="{DynamicResource MutedBrush}"
                                     FontSize="11"
                                     Padding="8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="OverallProgressBar" Height="5" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" />
                <TextBlock x:Name="OverallStatusText"
                           Grid.Column="2"
                           Text="就绪"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Button x:Name="EasterHeartButton"
                Content="🧡"
                Width="24"
                Height="24"
                MinHeight="0"
                Padding="0"
                FontSize="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="EasterHeart_Click" />

        <Grid x:Name="EasterOverlay" Visibility="Collapsed" Background="#66000000" MouseLeftButtonDown="EasterOverlay_MouseLeftButtonDown">
            <Border Width="430"
                    MaxWidth="430"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="EasterCard_MouseLeftButtonDown">
                <Grid>
                    <Button Content="×"
                            Width="28"
                            Height="28"
                            MinHeight="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="EasterClose_Click" />
                    <StackPanel Margin="8,34,8,12">
                        <TextBlock x:Name="EasterMessageText"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="我们是永远的最好的朋友！"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
