{
  "name": "ncm-batch-mp3-windows",
  "version": "1.1.2",
  "description": "Windows desktop app for batch converting NetEase Cloud Music NCM files to MP3.",
  "main": "src/main.js",
  "author": "enshuwu46-png",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test:core": "node scripts/test_core.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "cc.codex.ncmBatchMp3",
    "productName": "NCM 批量转 MP3",
    "copyright": "Use only with audio files you are allowed to convert.",
    "compression": "maximum",
    "directories": {
      "output": "../dist/windows",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/win/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "resources/FFMPEG_WINDOWS_NOTICE.txt",
        "to": "FFMPEG_WINDOWS_NOTICE.txt"
      },
      {
        "from": "../README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NCM-Batch-MP3-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NCM 批量转 MP3",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
